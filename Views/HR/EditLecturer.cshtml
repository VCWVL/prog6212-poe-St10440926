@model st10440926_poeparttwo.Models.LecturerProfile

<div class="container mt-4">
    <h2>Edit Lecturer</h2>

    <form asp-action="EditLecturer" method="post">

        <input type="hidden" name="OriginalUsername" value="@Model.Username" />

        <div class="mb-3">
            <label>Username</label>
            <input class="form-control" name="Username" value="@Model.Username" required />
        </div>

        <div class="mb-3">
            <label>Full Name</label>
            <input class="form-control" name="FullName" value="@Model.FullName" required />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input class="form-control" name="Email" value="@Model.Email" required />
        </div>

        <div class="mb-3">
            <label>Hourly Rate</label>
            <input class="form-control" name="HourlyRate" value="@Model.HourlyRate" required />
        </div>

        <button class="btn btn-success">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@await Html.PartialAsync("_BackToLogin")
