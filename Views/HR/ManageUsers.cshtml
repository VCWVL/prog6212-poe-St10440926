@model List<st10440926_poeparttwo.Models.UserModel>

@{
    ViewData["Title"] = "Manage Users";
}

@await Html.PartialAsync("_BackToLogin")

<h2 class="fw-bold text-primary mb-3">Manage Users</h2>
<p class="text-muted">HR can edit or remove all users in the system.</p>

<hr />

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Username</th>
                <th>Role</th>
                <th>Password</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Username</td>
                    <td>@user.Role</td>
                    <td>@user.Password</td>

                    <td>
                        <a asp-action="EditUser"
                           asp-route-username="@user.Username"
                           class="btn btn-sm btn-info">
                            Edit
                        </a>

                        <a asp-action="DeleteUser"
                           asp-route-username="@user.Username"
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Are you sure you want to delete this user?');">
                            Remove
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No users found.</p>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">← Back to Dashboard</a>
</div>
