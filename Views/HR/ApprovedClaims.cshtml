@model List<st10440926_poeparttwo.Models.ClaimModel>

<h2 class="mb-3 text-success fw-bold">Approved Claims</h2>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Lecturer</th>
            <th>Total Approved Claims</th>
            <th>Total Hours</th>
            <th>Total Amount (R)</th>
            <th>Report</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var group in Model.GroupBy(c => c.LecturerUsername))
        {
            var lecturer = group.Key;
            var totalHours = group.Sum(c => c.HoursWorked);
            var totalAmount = group.Sum(c => c.HoursWorked * c.HourlyRate);
            var claimCount = group.Count();

            <tr>
                <td>@lecturer</td>
                <td>@claimCount</td>
                <td>@totalHours</td>
                <td>@totalAmount</td>

                <td>
                    @if (claimCount > 0)
                    {
                        <a asp-action="GenerateApprovedReport"
                           asp-route-username="@lecturer"
                           class="btn btn-sm btn-success">
                            View Report
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-danger">No Report Available</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">
        ← Back
    </a>
</div>
