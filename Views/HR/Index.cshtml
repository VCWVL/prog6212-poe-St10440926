@model st10440926_poeparttwo.Models.HRDashboardViewModel

<div class="container mt-4">

    <h2 class="fw-bold text-primary">HR Dashboard</h2>
    <p class="text-muted">Manage users, lecturers, and hourly rates.</p>

    <hr />

    <!-- STANDARD HOURLY RATE -->
    <h4>Standard Hourly Rate</h4>
    <p><strong>Current Rate:</strong> R @Model.StandardRate per hour</p>
    <a class="btn btn-warning mb-3" asp-action="SetRate">Update Hourly Rate</a>

    <hr />

    <!-- LECTURER PROFILES -->
    <h4>Lecturer Profiles</h4>
    <a class="btn btn-success mb-3" asp-action="CreateLecturer">Create New Lecturer</a>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Username</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Hourly Rate</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.LecturerProfiles)
            {
                <tr>
                    <td>@l.Username</td>
                    <td>@l.FullName</td>
                    <td>@l.Email</td>
                    <td>R @l.HourlyRate</td>
                    <td>
                        <a asp-action="EditLecturer"
                           asp-route-username="@l.Username"
                           class="btn btn-sm btn-primary">
                            Edit
                        </a>

                        <a asp-action="DeleteLecturer"
                           asp-route-username="@l.Username"
                           class="btn btn-sm btn-danger"
                           onclick="return confirm('Are you sure you want to delete this lecturer?');">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <!-- USER ACCOUNTS -->
    <h4>System Users</h4>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Username</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td>@u.Username</td>
                    <td>@u.Role</td>
                </tr>
            }
        </tbody>
    </table>

</div>

@await Html.PartialAsync("_BackToLogin")
