@model st10440926_poeparttwo.Models.HRDashboardViewModel

@{
    ViewData["Title"] = "HR Dashboard";
}

@await Html.PartialAsync("_BackToLogin")

<h2 class="fw-bold text-primary mb-2">HR Dashboard</h2>
<p class="text-muted">Manage lecturers, hourly rates, and user accounts.</p>

<hr />


<!-- =============================== -->
<!-- SECTION 2 — LECTURER PROFILES -->
<!-- =============================== -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-success text-white">
        <h5 class="mb-0">Lecturer Profiles</h5>
    </div>

    <div class="card-body">

        @if (Model.Lecturers != null && Model.Lecturers.Any())
        {
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Hourly Rate</th>
                        <th>Report</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var lecturer in Model.Lecturers)
                    {
                        // All claims for this lecturer:
                        var claimsForLecturer = Model.Claims
                        .Where(c => c.LecturerUsername == lecturer.Username)
                        .ToList();

                        bool hasApprovedOrVerified = claimsForLecturer
                        .Any(c => c.Status == "Approved" || c.Status == "Verified");

                        bool noValidReport = claimsForLecturer.Count == 0 ||
                        claimsForLecturer.All(c => c.Status == "Rejected");

                        <tr>
                            <td>@lecturer.FullName</td>
                            <td>@lecturer.Username</td>
                            <td>R @lecturer.HourlyRate</td>

                            <td>
                                @if (hasApprovedOrVerified)
                                {
                                    <a asp-action="GenerateApprovedReport"
                                       asp-route-username="@lecturer.Username"
                                       class="btn btn-sm btn-primary">
                                        View Report
                                    </a>

                                }
                                else if (noValidReport)
                                {
                                    <span class="badge bg-danger">No Report Available</span>
                                }
                            </td>

                            <td>
                                <a asp-action="EditLecturer" asp-route-username="@lecturer.Username"
                                   class="btn btn-sm btn-info">Edit</a>

                                <a asp-action="DeleteLecturer" asp-route-username="@lecturer.Username"
                                   class="btn btn-sm btn-danger">Remove</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No lecturers found.</p>
        }

    </div>
</div>

<!-- =============================== -->
<!-- SECTION 3 — ACCOUNT CREATION -->
<!-- =============================== -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0">Create New User Account</h5>
    </div>

    <div class="card-body">
        <p class="text-muted">
            HR can create accounts for new Lecturers, Coordinators, or Managers.
        </p>

        <!-- ⭐ Correct button (no extra closing tag) -->
        <a asp-action="CreateUser" class="btn btn-dark">Create New User</a>
    </div>
</div>

<!-- =============================== -->
<!-- SECTION 4 — MANAGE ALL USERS -->
<!-- =============================== -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">Manage System Users</h5>
    </div>

    <div class="card-body">
        <p class="text-muted">View, edit, and remove any user account in the system.</p>

        <a asp-action="ManageUsers" class="btn btn-secondary">Manage Users</a>
    </div>
</div>

<!-- =============================== -->
<!-- SECTION 4 — CLAIMS OVERVIEW -->
<!-- =============================== -->
<div class="card mb-4 shadow-sm">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Claims Overview</h5>
    </div>

    <div class="card-body">
        <p class="text-muted">Monitor lecturer claims (HR view only).</p>

        <div class="d-flex gap-2">
            <a asp-action="PendingClaims" class="btn btn-outline-primary">Pending Claims</a>
            <a asp-action="VerifiedClaims" class="btn btn-outline-info">Verified Claims</a>
            <a asp-action="ApprovedClaims" class="btn btn-outline-success">Approved Claims</a>
        </div>
    </div>
</div>
