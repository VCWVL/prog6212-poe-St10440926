@model st10440926_poeparttwo.Models.UserModel
@{
    ViewData["Title"] = "Login";
}

<div class="container text-center mt-5">
    <h2 class="fw-bold text-success">Login</h2>
    <p class="text-muted">Select your role and enter the password to continue.</p>

    <!-- FIX: Added the missing form tag -->
    <form asp-action="Login" method="post" class="mt-4">

        <select name="Role" class="form-select w-50 mx-auto mb-3" required>
            <option value="">-- Select Role --</option>
            <option value="Lecturer">Lecturer</option>
            <option value="Coordinator">Coordinator</option>
            <option value="Manager">Manager</option>
            <option value="HR">HR</option>
        </select>

        <input type="password" name="Password" placeholder="Password"
               class="form-control w-50 mx-auto" />

        <button type="submit" class="btn btn-success mt-3">Login</button>

    </form> <!-- FIXED: Now the form has an opening and closing tag -->
    @if (ViewBag.Error != null)
    {
        <p class="text-danger mt-3">@ViewBag.Error</p>
    }
</div>
