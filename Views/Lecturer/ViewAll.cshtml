@model List<st10440926_poeparttwo.Models.ClaimModel>

@{
    ViewData["Title"] = "My Claims";
}

@await Html.PartialAsync("_BackToLogin")

<h2 class="mt-3">My Submitted Claims</h2>
<p class="text-muted">Here you can review all claims you have submitted.</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<hr />

@if (Model == null || !Model.Any())
{
    <p class="text-muted">You have not submitted any claims yet.</p>
}
else
{
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Date Submitted</th>
                <th>Hours</th>
                <th>Rate (R)</th>
                <th>Total (R)</th>
                <th>Notes</th>
                <th>File</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var claim in Model)
            {
                <tr>
                    <td>@claim.DateSubmitted.ToString("yyyy-MM-dd")</td>
                    <td>@claim.HoursWorked</td>
                    <td>@claim.HourlyRate</td>
                    <td>@(claim.HoursWorked* claim.HourlyRate)</td>
                    <td>@claim.Notes</td>

                    <!--  FILE VIEW + DOWNLOAD USING FILECONTROLLER -->
                    <td>
                        @if (!string.IsNullOrEmpty(claim.FileName))
                        {
                            <!-- VIEW FILE -->
                            <a asp-controller="File"
                               asp-action="ViewFile"
                               asp-route-fileName="@claim.FileName"
                               target="_blank"
                               class="text-primary text-decoration-underline">
                                @claim.FileName
                            </a>

                            <!-- DOWNLOAD FILE -->
                            <a asp-controller="File"
                               asp-action="DownloadFile"
                               asp-route-fileName="@claim.FileName"
                               class="btn btn-sm btn-outline-secondary ms-2">
                                Download
                            </a>
                        }
                        else
                        {
                            <span class="text-danger">No File</span>
                        }
                    </td>

                    <!-- STATUS -->
                    <td>
                        @if (claim.Status == "Approved")
                        {
                            <span class="badge bg-success">@claim.Status</span>
                        }
                        else if (claim.Status == "Verified")
                        {
                            <span class="badge bg-info text-dark">@claim.Status</span>
                        }
                        else if (claim.Status == "Rejected")
                        {
                            <span class="badge bg-danger">@claim.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">@claim.Status</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-4 d-flex gap-2">
    <a asp-action="Create" class="btn btn-primary">Submit New Claim</a>
    <a asp-controller="Lecturer" asp-action="Index" class="btn btn-secondary">
        ← Back to Dashboard
    </a>
</div>
