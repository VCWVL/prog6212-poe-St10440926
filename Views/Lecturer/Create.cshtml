@model st10440926_poeparttwo.Models.ClaimModel
@{
    ViewData["Title"] = "Submit Claim";
}

<h3>Submit Lecturer Claim</h3>

<!-- Validation summary  -->
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="Create" enctype="multipart/form-data" method="post" class="mt-3">

    <!-- REQUIRED HIDDEN FIELD FOR LECTURER USERNAME -->
    <input type="hidden" asp-for="LecturerUsername" />

    <!-- LECTURER NAME  -->
    <div class="mb-3">
        <label asp-for="LecturerName" class="form-label"></label>
        <input asp-for="LecturerName" class="form-control" readonly />
        <span asp-validation-for="LecturerName" class="text-danger"></span>
    </div>

    <!-- HOURS WORKED  -->
    <div class="mb-3">
        <label asp-for="HoursWorked" class="form-label"></label>
        <input asp-for="HoursWorked" class="form-control" />
        <span asp-validation-for="HoursWorked" class="text-danger"></span>
    </div>

    <!-- HOURLY RATE  -->
    <div class="mb-3">
        <label asp-for="HourlyRate" class="form-label"></label>
        <input asp-for="HourlyRate" class="form-control" readonly />
        <span asp-validation-for="HourlyRate" class="text-danger"></span>
    </div>

    <!-- SUPPORTING DOCUMENT UPLOAD -->
    <div class="mb-3">
        <label>Supporting Document</label>
        <input type="file" name="file" class="form-control" />
        <p class="text-muted small">Accepted: .pdf, .docx, .xlsx</p>
    </div>

    <!-- NOTES -->
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-success">Submit</button>

</form>
